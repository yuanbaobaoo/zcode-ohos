{
  "module": {
    "name": "electron",
    "type": "entry",
    "srcEntry": "./ets/Application/AbilityStage.ets",
    "description": "$string:module_desc",
    "mainElement": "EntryAbility",
    "deviceTypes": [
      "2in1",
      "tablet"
    ],
    "deliveryWithInstall": true,
    "installationFree": false,
    "pages": "$profile:main_pages",
    "metadata": [
      {
        "name": "client_id",
        "value": ""
      },
      {
        // v40 运行时子进程（utilityProcess/NodeService）经此路径 re-exec electron
        // 启动器（web_engine CmdArgsHelper 读取并拼 --electron-exec-path-ohos）。
        // 对应文件须落在 HAP libs/arm64-v8a/electron（装机归一化到该 bundle 路径）。
        "name": "electron_exec_path_ohos",
        "value": "/data/storage/el1/bundle/libs/arm64/electron"
      }
    ],
    "requestPermissions": [
      // 以下受限权限暂移除：debug 签名 allowed-acls 为空会安装失败（9568289）。
      // 恢复需在 AGC 为 Profile 申请 ACL：READ_WRITE_DESKTOP_DIRECTORY、READ_WRITE_USER_FILE。
      {
        "name": "ohos.permission.READ_PASTEBOARD",
        "reason": "$string:read_pasteboard",
        "usedScene": {
          "abilities": ["EntryAbility"],
          "when": "always"
        }
      },
      {
        // 2in1/PC 用户目录读写（受限，需 Profile ACL）：安装报 9568289 时在 Profile 的
        // allowed-acls 加入；运行时 requestPermissionsFromUser 弹窗授权。
        "name": "ohos.permission.READ_WRITE_USER_FILE",
        "reason": "$string:read_write_user_file",
        "usedScene": {
          "abilities": ["EntryAbility"],
          "when": "always"
        }
      },
      {
        "name": "ohos.permission.READ_WRITE_DOCUMENTS_DIRECTORY",
        "reason": "$string:documents_dir",
        "usedScene": {
          "abilities": ["EntryAbility"],
          "when": "always"
        }
      },
      {
        "name": "ohos.permission.READ_WRITE_DOWNLOAD_DIRECTORY",
        "reason": "$string:download_dir",
        "usedScene": {
          "abilities": ["EntryAbility"],
          "when": "always"
        }
      },
      {
        "name": "ohos.permission.FILE_ACCESS_PERSIST"
      },
      {
        // 无此权限则 libadapter 向所有进程注入 --jitless（V8 JIT/WASM 全关）；
        // 受限权限随 debug Profile ACL 下发（devecocli signature generate 自动申请）。
        "name": "ohos.permission.kernel.ALLOW_WRITABLE_CODE_MEMORY"
      },
      {
        // 电脑控制输入注入（spec 13）：API 26 inputEventClient 的受限权限，仅 PC/2in1。
        // 受限权限随 debug Profile ACL 下发（devecocli signature generate 按 module.json5
        // 自动申请；CLT 模式需带 DEVECO_CLI_CLT_PATH）。若 Profile ACL 缺失则装机 9568289
        // （真机实证 2026-11-03），届时按上法重生成 Profile。
        "name": "ohos.permission.CONTROL_DEVICE",
        "reason": "$string:computer_control",
        "usedScene": {
          "abilities": ["EntryAbility"],
          "when": "always"
        }
      },
      {
        // 屏幕捕获（spec 15 M3）：desktopCapturer 在 OHOS 走 AVScreenCapture，系统要求
        // ohos.permission.CUSTOM_SCREEN_CAPTURE（user_grant / normal，third-party 可声明）。
        // 缺失时系统判 "Verify custom screen recording failed"，取帧调用永不返回（真机实证）。
        "name": "ohos.permission.CUSTOM_SCREEN_CAPTURE",
        "reason": "$string:screen_capture",
        "usedScene": {
          "abilities": ["EntryAbility"],
          "when": "inuse"
        }
      },
      {
        // 用户全盘访问（PC/2in1，manual_settings）：覆盖 home 以外、未经选择器授权路径的
        // 读写（用户目录工具链的 exec 由 CUSTOM_SANDBOX 解锁，实测授予本权限无效，见装机排障 #15）。
        // 对应设置「访问全盘文件」开关；引导入口见 spec 08（一次性 toast + 设置页开关）。
        "name": "ohos.permission.ACCESS_USER_FULL_DISK",
        "reason": "$string:access_user_full_disk",
        "usedScene": {
          "abilities": ["EntryAbility"],
          "when": "always"
        }
      },
      {
        // 动态沙箱（API 18+，system_grant）：应用沙箱类型切换为动态沙箱后，
        // 子进程可 exec 用户目录中的 ELF（zsh 环境里安装的工具链依赖该解锁；
        // 普通沙箱 exec 用户目录二进制被 MAC 拦，实测 EPERM）。
        "name": "ohos.permission.CUSTOM_SANDBOX"
      },
      {
        "name": "ohos.permission.INTERNET"
      },
      {
        "name": "ohos.permission.GET_NETWORK_INFO"
      },
    ],

    // HarmonyOS 7.0 上随 HAP 安装 native package（electron.hnp）报 9568407，
    // 先停用以解锁应用本体装机冒烟；HNP（agent/终端的 spawn 入口）另行解决后恢复：
    // 1) 恢复本段 hnpPackages；2) electron/hvigorfile.ts 重新注册 HnpPlugin。
    // "hnpPackages": [
    //   {
    //     "package": "electron.hnp",
    //     "type": "public"
    //   }
    // ],

    "abilities": [
      {
        "name": "EntryAbility",
        "srcEntry": "./ets/entryability/EntryAbility.ets",
        "description": "$string:EntryAbility_desc",
        "icon": "$media:app_icon",
        "label": "$string:EntryAbility_label",
        "startWindowIcon": "$media:startIcon",
        "startWindowBackground": "$color:start_window_background",
        "launchType": "specified",
        "removeMissionAfterTerminate": true,
        "exported": true,
        "skills": [
          {
            "entities": [
              "entity.system.home",
              "entity.system.browsable"
            ],
            "actions": [
              "action.system.home",
              "ohos.want.action.viewData"
            ],
            "uris": []
          },
          {
            "entities": [
              "entity.system.browsable"
            ],
            "actions": [
              "ohos.want.action.viewData"
            ],
            "uris": [
              {
                // ZCode OAuth 登录回调深链 (zcode://oauth/callback)，
                // 授权页在系统浏览器完成授权后通过该 scheme 回跳本应用
                "scheme": "zcode"
              }
            ]
          }
        ],
        "metadata": [
          {
            "name": "ohos.ability.shortcuts",
            "resource": "$profile:shortcuts_config"
          },
        ],
      },
      {
        // v40 厂商注册形态（exported: true、无独立 :browser 进程、无 viewData skill）——
        // ability 实现随 web_engine 版本走，注册形态跟随厂商基线。
        "name": "BrowserAbility",
        "srcEntry": "./ets/entryability/BrowserAbility.ets",
        "description": "$string:BrowserAbility_desc",
        "startWindowIcon": "$media:app_icon",
        "startWindowBackground": "$color:start_window_background",
        "removeMissionAfterTerminate": true,
        "exported": true,
      },
      {
        "name": "StatelessAbility",
        "srcEntry": "./ets/entryability/StatelessAbility.ets",
        "description": "$string:StatelessAbility_desc",
        "label": "$string:StatelessAbility_label",
        "startWindowIcon": "$media:app_icon",
        "startWindowBackground": "$color:start_window_background",
        "launchType": "specified",
        "removeMissionAfterTerminate": true,
        "exported": true,
      },
      {
        "name": "TaskManagerAbility",
        "srcEntry": "./ets/entryability/TaskManagerAbility.ets",
        "description": "$string:TaskManagerAbility_desc",
        "label": "$string:TaskManagerAbility_label",
        "startWindowIcon": "$media:app_icon",
        "startWindowBackground": "$color:start_window_background",
        "launchType": "specified",
        "removeMissionAfterTerminate": true,
        "exported": true,
      },
      {
        "name": "HideKeeperAbility",
        "srcEntry": "./ets/entryability/HideKeeperAbility.ets",
        "startWindowIcon": "$media:app_icon",
        "startWindowBackground": "$color:start_window_background",
        "launchType": "singleton",
        "excludeFromMissions": true,
        "removeMissionAfterTerminate": true,
        "exported": false,
      }
    ],
    "extensionAbilities": [
      {
        "name": "StatusBarEntryAbility",
        "icon": "$media:app_icon",
        "description": "$string:StatusBarEntryAbility_desc",
        "type": "statusBarView",
        "exported": false,
        "srcEntry": "./ets/entryability/StatusBarEntryAbility.ets"
      },
      {
        "name": "BrowserEmbeddedAbility",
        "srcEntry": "./ets/extensionAbility/BrowserEmbeddedAbility.ets",
        "type": "embeddedUI",
        "exported": false,
      }
    ],
    // v40 厂商新增：自定义声明内核可写可执行权限（与上方 requestPermissions 的
    // 同名受限权限配套，define 使 ACL 下发生效）。
    "definePermissions": [
      {
        "name": "ohos.permission.kernel.ALLOW_WRITABLE_CODE_MEMORY"
      }
    ]
  }
}
