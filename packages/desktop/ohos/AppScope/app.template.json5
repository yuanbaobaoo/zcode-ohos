{
  app: {
    bundleName: "ai.ohpc.zcode",
    vendor: "glm",
    // 版本占位符：bundle-ohos.mjs / dev-ohos.mjs 经 ohos-version.mjs 生成 app.json5
    //（versionName 跟随发版 tag，versionCode 编码规则见 specs/ohos-port/04-版本与更新.md）
    versionCode: "__OHOS_VERSION_CODE__",
    versionName: "__OHOS_VERSION_NAME__",
    icon: "$media:app_icon",
    label: "$string:app_name",
    configuration: "$profile:configuration",
    multiAppMode: {
      multiAppModeType: "multiInstance",
      maxCount: 5,
    },
  },
}
