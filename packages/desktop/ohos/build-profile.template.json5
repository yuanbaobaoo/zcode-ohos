// build-profile.json5 模板 —— 供新环境初始化使用。
//
// 复制为 packages/desktop/ohos/build-profile.json5（机器相关，不入库）并填入签名材料；
// 获取方式（AGC 手动 / devecocli 一键）与无签名行为见 specs/ohos-port/01「签名材料获取」。
{
  app: {
    products: [
      {
        name: 'default',
        compatibleSdkVersion: '6.0.2(22)',
        targetSdkVersion: '26.0.0',
        runtimeOS: 'HarmonyOS',
        buildOption: {
          nativeLib: {
            collectAllLibs: true,
          },
        },
        // signingConfig: 'default',  // 有签名材料时取消注释（指向下方 signingConfigs[].name）
      },
    ],
    buildModeSet: [
      {
        name: 'debug',
      },
      {
        name: 'release',
      },
    ],
    signingConfigs: [
      // 有签名材料时填入（示例）：
      // {
      //   name: 'default',
      //   type: 'HarmonyOS',
      //   material: {
      //     certpath: '<你的 .cer 路径>',
      //     keyAlias: 'debugKey',
      //     keyPassword: '<生成材料时得到>',
      //     profile: '<你的 .p7b 路径>',
      //     signAlg: 'SHA256withECDSA',
      //     storeFile: '<你的 .p12 路径>',
      //     storePassword: '<生成材料时得到>',
      //   },
      // },
    ],
  },
  modules: [
    {
      name: 'electron',
      srcPath: './electron',
      targets: [
        {
          name: 'default',
          applyToProducts: [
            'default',
          ],
        },
      ],
    },
    {
      name: 'web_engine',
      srcPath: './web_engine',
    },
  ],
}
